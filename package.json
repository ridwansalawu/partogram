{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "devstart": "nodemon ./bin/www",
    "build-web": "yarn --cwd frontend install && yarn --cwd frontend build",
    "deploy-web": "cp -a frontend/build/. public/",
    "heroku-postbuild": "yarn build-web && yarn deploy-web"
  },
  "dependencies": {
    "body-parser": "^1.19.0",
    "connect-mongo": "^4.6.0",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "dotenv": "^17.3.1",
    "express": "~4.16.1",
    "express-session": "^1.17.0",
    "helmet": "^3.21.2",
    "html-pdf": "^2.2.0",
    "http-errors": "~1.6.3",
    "jade": "~1.11.0",
    "locus": "^2.0.4",
    "mongoose": "^5.8.9",
    "morgan": "~1.9.1",
    "multer": "^1.4.2",
    "nodemon": "^2.0.2",
    "passport": "^0.4.1",
    "passport-facebook-token": "^3.3.0",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "passport-local-mongoose": "^6.0.1",
    "session-file-store": "^1.3.1",
    "socket.io": "^2.3.0"
  },
  "engines": {
    "node": "18.x"
  }
}
